{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mallet",
  "version": "0.1.0",
  "identifier": "dev.mallet.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mallet",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "backgroundColor": "#12151c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Mallet",
    "shortDescription": "Source map editor for Garry's Mod",
    "longDescription": "Mallet is a map editor for Garry's Mod and other Source games: brushes, entities, displacements, VMF round trip, compile and pack, with a built-in assistant.",
    "copyright": "© 2026 Mallet contributors",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "German",
          "French",
          "Spanish",
          "PortugueseBR",
          "Polish",
          "Turkish",
          "Ukrainian",
          "SimpChinese",
          "Japanese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi",
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        }
      }
    }
  }
}
