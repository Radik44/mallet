; Mallet installer hooks (see tauri.conf.json → bundle.windows.nsis.installerHooks).
;
; The installer asks for a language on its first page. The editor starts in the
; same language: the LCID the person picked ($LANGUAGE) is written next to the
; executable, and the shell reads it on the first start before any saved choice
; exists (installer_language in lib.rs).

; The folder of this file: installer.nsi includes strings.nsh and the licence files from it.
!define MALLET_INSTALLER_DIR "${__FILEDIR__}"
; The licence of the chosen language, extracted by the licence page (generated by make_strings.py).
!include "${MALLET_INSTALLER_DIR}\license-extract.nsh"

!macro NSIS_HOOK_POSTINSTALL
  ClearErrors
  FileOpen $0 "$INSTDIR\installer-language.txt" w
  IfErrors mallet_lang_done
  FileWrite $0 "$LANGUAGE"
  FileClose $0
  mallet_lang_done:
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  Delete "$INSTDIR\installer-language.txt"
!macroend
